#!/usr/bin/env bash
# Plausibility audit of a generated city (docs/sanity-audit.md).
#
#   scripts/sanity-audit                         the demo city
#   scripts/sanity-audit --world 284735          a town of a generated world
#   scripts/sanity-audit --world 7 --landform plateau --json /tmp/a.json
#
# Takes the arguments of `dump_scene` plus --json, --top, --no-gate. Exits 1 when
# a check is over its gate (the demo city must stay at or under every gate).
set -euo pipefail
cd "$(dirname "$0")/.."
exec cargo run --release -q -p city-scene --example sanity_audit -- "$@"
